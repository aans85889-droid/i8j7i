<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="125dp"
    android:layout_marginBottom="0dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#8018181C"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Card.TopRounded"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <ProgressBar
            android:id="@+id/miniProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_toEndOf="@+id/miniImageContainer"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="2dp"
            android:progress="0"
            android:progressTint="#FF1E66"
            android:progressBackgroundTint="#33FFFFFF"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/miniImageContainer"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#000000">

            <ImageView
                android:id="@+id/ivArtistImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/btnMiniClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#AAAAAA"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/circle_button_glass"
            android:padding="6dp" />

        <LinearLayout
            android:id="@+id/miniTextContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@+id/miniImageContainer"
            android:layout_toStartOf="@+id/btnMiniClose"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvMiniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسم الشيلة الحالية"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvMiniArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسم الفنان"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:singleLine="true"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/miniControlsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_toEndOf="@+id/miniImageContainer"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="9dp"
            android:layout_marginStart="60dp">

            <ImageView
                android:id="@+id/btnMiniPrev"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_next_modern"
                app:tint="#FFFFFF"
                android:background="@drawable/circle_button_glass"
                android:padding="7dp" />

            <ImageView
                android:id="@+id/btnMiniPlayPause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_pause_modern"
                app:tint="#FFFFFF"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/circle_button_glass"
                android:padding="9dp" />

            <ImageView
                android:id="@+id/btnMiniNext"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_prev_modern"
                app:tint="#FFFFFF"
                android:background="@drawable/circle_button_glass"
                android:padding="7dp" />
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>